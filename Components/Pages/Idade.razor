@page "/idade"
@rendermode InteractiveServer

<input type="number" @bind="idade" @bind:event="oninput" />

<p> Faixa etária: @Classificar(idade)</p>
<p> Maior de idade? @EhMaiorDeIdade(idade)</p>

@code {
    int idade = 0;

    String Classificar (int anos)
    {
        if (anos <12)
        {
            return "Crianças";
        }
        else if (idade < 18)
        {
            return "Adolescente";
        }
        else if (idade < 60)
        {
            return "Adulto";
        }
        else
        {
            return "Idoso";
        }
    }

    bool EhMaiorDeIdade(int anos)
    {
        return anos >= 18;
    }
}